{
  "expo": {
    "name": "SplitIT",
    "slug": "splitit",
    "scheme": "splitit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#130B26",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.splitit"
    },
    "android": {
      "package": "app.splitit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#130B26"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "image/*" }]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#130B26"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SplitIT opens your photos only when you pick a receipt to attach.",
          "cameraPermission": "SplitIT uses the camera only when you photograph a receipt.",
          "microphonePermission": "SplitIT listens only while you say an expense."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SplitIT listens only while you say an expense.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8A317",
          "defaultChannel": "activity"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "amazon-h6",
          "project": "splitit-app",
          "url": "https://sentry.io/"
        }
      ]
    ]
  }
}
